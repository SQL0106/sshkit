#!/bin/sh
# rsh —— 给 agent/脚本用的 ssh 外壳（POSIX 目标：Linux / Android / macOS）
#
# 用法：
#   rsh <host>                  # 交互登录（强制落到 bash -l）
#   rsh <host> <cmd> [args...]  # 直接执行；强制用远端 bash 解析
#   rsh -f <host> <本地脚本>     # 把脚本喂给远端 bash -s（免除一切引号/heredoc 地狱）
#   rsh -f <host> -             # 从 stdin 读脚本
#   rsh -s <host> <单条命令>     # 用 sudo -n 执行；复合命令（; && |）报错，请改用 -f
#   rsh -n <host> ...           # native：不改 shell，用远端默认 shell（zsh/sh）
#   rsh --sess <host> <cmd>     # 走 sess 常驻会话：cd/变量/函数跨命令保留（~45ms/条）
#   rsh --sess -f <host> <脚本>  # 同上，脚本整段送进常驻会话
#   rsh -H <host> <cmd>         # 直落宿主 shell，忽略容器映射/自动探测
#   rsh -c <容器> <host> <cmd>  # 指定容器（跳过自动探测）
#   rsh -R <host> <cmd>         # 强制重新探测 droidspaces/容器（忽略缓存）
#   rsh containers <host>       # 显示该机的 droidspaces 与容器，并刷新缓存
#
# droidspaces 容器直连（Android/KernelSU）：
#   容器里跑着 sshd 时**优先用它的 ssh 别名**（示例：rsh android-c，~/.ssh/config 里
#   Port 22）——scp/sess/ControlMaster 全套语义都可用，rsh 不需要任何包装。
#   容器没跑 sshd 时，用 droidspaces 包装模式落进容器：
#     - 显式映射 ~/.config/sshkit/containers，每行：<host><空白><容器名>[<TAB><droidspaces路径>]
#         linux-host debian-13
#         android-host  Debian 13<TAB>/data/local/Droidspaces/bin/droidspaces
#       容器名可含空格（取到 TAB 或行尾），# 注释、空行忽略。
#     - 没有映射就自动探测：远端有 droidspaces 且**只有一个**容器时自动进入，结果缓存
#       在 ~/.cache/sshkit/<host>.container（-R 强制刷新；RSH_AUTODETECT=0 关闭）。
#     - 有多个容器且没映射 → 列出候选并 exit 2（用 -c 或写映射文件）。
#   命中后：
#     rsh <host> <cmd>       → droidspaces -n '<容器>' run -- bash --noprofile --norc -c ...
#     rsh -f <host> <脚本|->  → droidspaces -n '<容器>' run -- bash -s
#     rsh <host>             → droidspaces -n '<容器>' run -- bash -l
#   容器模式跳过宿主的 PATH/agent 前导（容器里没有那套 agent，探测只会误报）。
#   回宿主 shell：-H/--host-shell 或 RSH_HOST_SHELL=1。
#   --sess 与容器包装模式不兼容（keeper 在宿主上）→ exit 2；需要 sess/scp 就用容器 sshd 别名。
#
# 做的事：
#   1) 本地：agent 未解锁时才调 ssh-unlock（先内联 ssh-add -l，省一次 fork）
#   2) 复用 ControlMaster 连接（第二条命令 ~0.05s）
#   3) **强制 bash**：LLM 的默认知识是 bash，远端若把 zsh/sh 设成登录 shell，
#      `rsh host 'cmd'` 会把命令交给 bash -c 而不是 zsh -c；命令本地 base64 编码，
#      远端 `eval "$(printf %s B64 | base64 -d)"`，不经任何二次引号解析。
#      远端没有 bash 时自动退回 sh。
#   4) -f 模式：ssh host 'bash -s' < file —— 脚本里可以随便写引号、变量、管道
#   5) 远端 PATH 前置 ~/.local/bin（存在时，-n 除外）
#   6) 远端 ssh-agent **按需自愈**（命令涉及 git/ssh/scp/sftp/rsync 时）：
#      一次 ssh-add -l 判定 → 陈旧 socket 就重启 agent → 再 ssh-unlock。
#      控制：RSH_AGENT=auto|always|off（默认 auto；off = 本地与远端都不碰），
#      RSH_NO_AGENT_FIX=1 彻底关闭。
#      失败静默降级，只在 stderr 打一行诊断，不阻塞命令。

set -u

self=$(basename "$0")
agent_mode=${RSH_AGENT:-auto}
no_fix=${RSH_NO_AGENT_FIX:-0}
# 判断「这条命令是否可能要 agent」的词边界正则（本地 grep，不占远端往返）
agent_re='(^|[^[:alnum:]_.-])(git|ssh|scp|sftp|rsync)([[:space:]]|$|-)'

# 本地 agent：先内联探测（ssh-add -l ~6ms，好着就不 fork ssh-unlock，省 ~25ms）；
# rc=2 说明 socket 陈旧或 agent 已死（unit 失败）→ 就地重启再解锁（与远端同一套故障）。
# 没有持久 agent 的机器（无 socket 也无本机 unit）不打扰。RSH_AGENT=off 连本地也不碰。
if [ "$no_fix" != 1 ] && [ "$agent_mode" != off ]; then
    local_rc=0
    if [ -e "$HOME/.ssh/agent.sock" ]; then
        SSH_AUTH_SOCK="$HOME/.ssh/agent.sock" ssh-add -l >/dev/null 2>&1; local_rc=$?
    elif [ -f "$HOME/.config/systemd/user/ssh-agent.service" ]; then
        local_rc=2
    fi
    if [ "$local_rc" -eq 2 ]; then
        rm -f "$HOME/.ssh/agent.sock"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user restart ssh-agent >/dev/null 2>&1 || true
        fi
        # agent 起来要几毫秒，直接 ssh-add 会撞 Connection refused
        _w=0
        while [ "$local_rc" -eq 2 ] && [ "$_w" -lt 10 ]; do
            sleep 0.1
            SSH_AUTH_SOCK="$HOME/.ssh/agent.sock" ssh-add -l >/dev/null 2>&1; local_rc=$?
            _w=$((_w + 1))
        done
    fi
    if [ "$local_rc" -ne 0 ] && [ -x "$HOME/.local/bin/ssh-unlock" ]; then
        "$HOME/.local/bin/ssh-unlock" >/dev/null 2>&1 || true
    fi
fi

usage() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

mode=exec
sudo_run=0
native=0
use_sess=0
host_shell=0
refresh=0
opt_container=""
while [ $# -gt 0 ]; do
    case "$1" in
        -f) mode=file; shift ;;
        -s) sudo_run=1; shift ;;
        -n) native=1; shift ;;
        -S|--sess) use_sess=1; shift ;;
        -H|--host-shell) host_shell=1; shift ;;
        -R|--refresh) refresh=1; shift ;;
        -c|--container)
            [ $# -ge 2 ] || { echo "$self: -c 需要容器名" >&2; exit 2; }
            opt_container=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "$self: 未知选项 $1" >&2; exit 2 ;;
        *) break ;;
    esac
done

subcmd=""
if [ "${1:-}" = containers ]; then
    subcmd=containers
    shift
    [ $# -ge 1 ] || { echo "$self: 用法: $self containers <host>" >&2; exit 2; }
fi

[ $# -ge 1 ] || { usage; exit 2; }
host=$1; shift

# ---- droidspaces 容器：显式映射优先；未配置时自动探测（只有一个容器才进）----
CONTAINERS_FILE=${SSHKIT_CONTAINERS:-"$HOME/.config/sshkit/containers"}
DS=${RSH_DROIDSPACES:-/data/local/Droidspaces/bin/droidspaces}
CACHE_DIR=${SSHKIT_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/sshkit}
CACHE_FILE=$CACHE_DIR/$(printf '%s' "$host" | tr -c 'A-Za-z0-9._-' '_').container
container_name=""
container_ds=$DS
in_container=0

# 单引号引用；值里出现单引号直接拒绝（容器名/路径不该有）
shq() {
    case "$1" in
        *\'*) echo "$self: 该值含单引号，无法安全引用: $1" >&2; exit 2 ;;
    esac
    printf "'%s'" "$1"
}

# 命中映射行 → 打印 "<容器名>\t<droidspaces路径>"（路径可空），未命中 rc=1。
# 容器名允许空格：TAB 之前全是名字，TAB 之后是可选路径（不会出现在行首注释里）。
container_lookup() {
    [ -f "$CONTAINERS_FILE" ] || return 1
    awk -v h="$1" '
        { sub(/\r$/, "") }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*$/ { next }
        $1 == h {
            line = $0
            sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            t = index(line, "\t")
            if (t > 0) {
                name = substr(line, 1, t - 1)
                ds = substr(line, t + 1)
                sub(/[[:space:]]+$/, "", name)
            } else { name = line; ds = "" }
            printf "%s\t%s\n", name, ds
            found = 1; exit 0
        }
        END { if (!found) exit 1 }
    ' "$CONTAINERS_FILE"
}

# 一次 ssh 拿回「droidspaces 路径 + show 输出」：@@none / @@bin\t<path>\n<b64(show)>
# 返回 0 有 droidspaces，1 宿主没有，2 连不上/输出异常。
probe_remote() {
    _dsq=$(shq "$DS")
    _probe="_ds=$_dsq
if [ -x \"\$_ds\" ]; then _b=\$_ds; else _b=\$(command -v droidspaces 2>/dev/null || true); fi
if [ -n \"\$_b\" ] && [ -x \"\$_b\" ]; then
    printf '@@bin\\t%s\\n' \"\$_b\"
    \"\$_b\" show 2>/dev/null | base64 | tr -d '\\n'
    printf '\\n'
else
    printf '@@none\\n'
fi"
    _out=$(ssh -T "$host" "$_probe" </dev/null 2>/dev/null) || return 2
    case $_out in
        @@none) return 1 ;;
        @@bin*) : ;;
        *) return 2 ;;
    esac
    p_bin=$(printf '%s\n' "$_out" | sed -n '1s/^@@bin	//p')
    p_b64=$(printf '%s\n' "$_out" | sed -n '2p')
    [ -n "$p_bin" ] || return 2
    p_list=$(printf '%s' "$p_b64" | base64 -d 2>/dev/null | awk -F'│' '
        NF > 2 {
            n = $2; p = $3
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", n)
            gsub(/[[:space:]]+/, "", p)
            if (n != "" && n != "NAME" && p ~ /^[0-9]+$/) printf "%s\t%s\n", n, p
        }')
    return 0
}

cache_write() {
    [ -d "$CACHE_DIR" ] || mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
    _tmp=$CACHE_FILE.tmp.$$
    if printf '%s\n' "$1" > "$_tmp" 2>/dev/null; then
        mv -f "$_tmp" "$CACHE_FILE" 2>/dev/null || rm -f "$_tmp"
    else
        rm -f "$_tmp"
    fi
}

# 容器清单（供 rsh containers 复用）
print_container_list() {
    printf '%s\n' "$p_list" | awk -F'\t' '{ printf "  %-24s pid=%s\n", $1, $2 }'
}

if [ "$host_shell" -eq 0 ] && [ "${RSH_HOST_SHELL:-0}" != 1 ] && [ "$subcmd" != containers ]; then
    if _m=$(container_lookup "$host"); then
        container_name=$(printf '%s' "$_m" | cut -f1)
        _mds=$(printf '%s' "$_m" | cut -f2)
        [ -n "$_mds" ] && container_ds=$_mds
        in_container=1
    else
        _want=${opt_container:-${RSH_CONTAINER:-}}
        if [ -n "$_want" ]; then
            container_name=$_want
            in_container=1
        elif [ "${RSH_AUTODETECT:-1}" != 0 ]; then
            if [ "$refresh" -eq 0 ] && [ -f "$CACHE_FILE" ]; then
                _c=$(cat "$CACHE_FILE" 2>/dev/null || true)
                if [ "$_c" != none ] && [ -n "$_c" ]; then
                    container_name=$(printf '%s' "$_c" | cut -f1)
                    _cds=$(printf '%s' "$_c" | cut -f2)
                    [ -n "$_cds" ] && container_ds=$_cds
                    in_container=1
                fi
            else
                _prc=0; probe_remote || _prc=$?
                case $_prc in
                    0)
                        _cnt=$(printf '%s' "$p_list" | awk 'NF { n++ } END { print n + 0 }')
                        if [ "$_cnt" -eq 1 ]; then
                            container_name=$(printf '%s\n' "$p_list" | cut -f1)
                            container_ds=$p_bin
                            _line=$(printf '%s\t%s' "$container_name" "$p_bin")
                            cache_write "$_line"
                            in_container=1
                        elif [ "$_cnt" -eq 0 ]; then
                            cache_write none
                        else
                            echo "$self: $host 上有多个 droidspaces 容器，无法自动选择：" >&2
                            print_container_list >&2
                            echo "      用 -c '<容器名>' 指定，或写映射：$CONTAINERS_FILE ← $host <容器名>" >&2
                            echo "      要留在宿主 shell 加 -H。" >&2
                            exit 2
                        fi ;;
                    1) cache_write none ;;
                    *) : ;;  # ssh 本身失败：不缓存，交给主命令给出真实报错
                esac
            fi
        fi
    fi
fi

if [ "$subcmd" = containers ]; then
    _prc=0; probe_remote || _prc=$?
    case $_prc in
        0)
            printf 'droidspaces: %s\n' "$p_bin"
            _cnt=$(printf '%s' "$p_list" | awk 'NF { n++ } END { print n + 0 }')
            if [ "$_cnt" -eq 0 ]; then
                echo "  （没有容器）"
                cache_write none
            else
                print_container_list
                if [ "$_cnt" -eq 1 ]; then
                    container_name=$(printf '%s\n' "$p_list" | cut -f1)
                    _line=$(printf '%s\t%s' "$container_name" "$p_bin")
                    cache_write "$_line"
                    echo "已缓存：下次 $self $host 自动进该容器（-R 刷新，-H 回宿主）"
                else
                    echo "多个容器：请用 -c '<容器名>' 或映射文件 $CONTAINERS_FILE" >&2
                    exit 3
                fi
            fi
            exit 0 ;;
        1) cache_write none; echo "$self: $host 上没有 droidspaces（回宿主 shell）" >&2; exit 3 ;;
        *) echo "$self: 连不上 $host" >&2; exit 3 ;;
    esac
fi

if [ "$in_container" -eq 1 ] && [ "$use_sess" -eq 1 ]; then
    echo "$self: --sess 与容器包装模式不兼容（sess keeper 在宿主 shell 上）。" >&2
    echo "      去掉 --sess（普通 ssh）；容器自己跑了 sshd 时改用它的别名；或加 -H 留在宿主。" >&2
    exit 2
fi

# 远端 PATH 前置 ~/.local/bin（纯内建，无 fork；-n 保持原生语义不动）
path_prelude='case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) if [ -d "$HOME/.local/bin" ]; then PATH="$HOME/.local/bin:$PATH"; export PATH; fi ;;
esac'

# 远端 agent 探测 + 自愈（POSIX sh，兼容远端 sh/zsh/bash）。
# 绝不删除/重启指向外部（转发）agent 的 SSH_AUTH_SOCK；口令只从远端环境取。
agent_prelude='_rsh_sock=$HOME/.ssh/agent.sock
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$_rsh_sock" ]; then SSH_AUTH_SOCK=$_rsh_sock; export SSH_AUTH_SOCK; fi
_rsh_broke=0
_rsh_rc=2
if [ -n "${SSH_AUTH_SOCK:-}" ]; then ssh-add -l >/dev/null 2>&1; _rsh_rc=$?; fi
# 只有「装了常驻 agent」的机器才修：socket 存在（含陈旧）或本机 unit 存在
_rsh_persist=0
if [ -e "$_rsh_sock" ] || [ -f "$HOME/.config/systemd/user/ssh-agent.service" ]; then _rsh_persist=1; fi
if [ "$_rsh_rc" -eq 2 ] && [ "$_rsh_persist" -eq 1 ] && { [ -z "${SSH_AUTH_SOCK:-}" ] || [ "${SSH_AUTH_SOCK}" = "$_rsh_sock" ]; }; then
    _rsh_broke=1
    rm -f "$_rsh_sock"
    if command -v systemctl >/dev/null 2>&1 && systemctl --user restart ssh-agent >/dev/null 2>&1; then :
    elif command -v ssh-agent >/dev/null 2>&1; then ssh-agent -a "$_rsh_sock" >/dev/null 2>&1 || true
    fi
    SSH_AUTH_SOCK=$_rsh_sock; export SSH_AUTH_SOCK
    ssh-add -l >/dev/null 2>&1; _rsh_rc=$?
    _rsh_w=0
    while [ "$_rsh_rc" -eq 2 ] && [ "$_rsh_w" -lt 10 ]; do
        sleep 0.1
        ssh-add -l >/dev/null 2>&1; _rsh_rc=$?
        _rsh_w=$((_rsh_w + 1))
    done
fi
if [ "$_rsh_rc" -ne 0 ] && [ "$_rsh_persist" -eq 1 ] && [ -x "$HOME/.local/bin/ssh-unlock" ]; then
    "$HOME/.local/bin/ssh-unlock" >/dev/null 2>&1
    ssh-add -l >/dev/null 2>&1; _rsh_rc=$?
fi
if [ "$_rsh_rc" -ne 0 ] && [ "$_rsh_persist" -eq 1 ] && command -v bash >/dev/null 2>&1; then
    bash -ic "command -v ssh-unlock >/dev/null 2>&1 && ssh-unlock" </dev/null >/dev/null 2>&1
    ssh-add -l >/dev/null 2>&1; _rsh_rc=$?
fi
if [ "$_rsh_rc" -ne 0 ] && { [ "$_rsh_broke" -eq 1 ] || { [ "$_rsh_persist" -eq 1 ] && [ -S "$_rsh_sock" ]; }; }; then
    echo "rsh: 远端 ssh-agent 无可用身份（socket=${SSH_AUTH_SOCK:-未设置}），git/ssh 可能报 publickey 失败；在该机执行: rm -f ~/.ssh/agent.sock && systemctl --user restart ssh-agent && ssh-unlock" >&2
fi
unset _rsh_sock _rsh_rc _rsh_broke _rsh_w _rsh_persist'

# 这条命令是否值得探测远端 agent（纯本地判断）
agent_wanted() {
    case "$agent_mode" in
        off) return 1 ;;
        always) return 0 ;;
    esac
    [ "$no_fix" = 1 ] && return 1
    printf '%s' "$1" | grep -Eq "$agent_re"
}

# 生成「本地 base64 → 远端解码后 eval」的内层串（不含外层解释器，无单引号）。
b64_eval() {
    b64=$(printf '%s' "$1" | base64 | tr -d '\n')
    printf 'eval "$(printf %%s %s | base64 -d 2>/dev/null || printf %%s %s | base64 -D)"' "$b64" "$b64"
}

# 把一段脚本文本包成「远端强制 bash 执行」的命令串。
wrap() {
    _e=$(b64_eval "$1")
    if [ "$native" -eq 1 ]; then
        printf '%s' "$_e"
    else
        printf '%s' "if command -v bash >/dev/null 2>&1; then bash --noprofile --norc -c '$_e'; else sh -c '$_e'; fi"
    fi
}

# 容器前缀：<ds> -n '<容器>' run --
cprefix() {
    printf '%s -n %s run --' "$(shq "$container_ds")" "$(shq "$container_name")"
}

# -s 只对「单条命令」成立：sudoers 按命令路径授权，包一层 bash 必被拒；
# 复合命令静默只给第一段加 sudo 更糟（报错混排、极易误判）→ 直接拒绝。
# 放行 `\;`（find -exec 的常规写法）。
sudo_check() {
    case "$1" in
        *'
'*) bad=1 ;;
        *) bad=0 ;;
    esac
    printf '%s' "$1" | grep -Eq '&&|[|]|(^|[^\\]);' && bad=1
    if [ "$bad" -eq 1 ]; then
        echo "$self: -s 只支持单条命令（sudoers 按命令路径授权，不能包一层 bash）。" >&2
        echo "      复合命令（; && |）请改用：$self -f <host> <脚本>，在脚本里对需要的行写 sudo -n" >&2
        echo "      （若只是参数里含这些字符，同样走 -f）" >&2
        exit 2
    fi
}

if [ "$mode" = file ]; then
    src=${1:-}
    [ -n "$src" ] || { echo "$self: -f 需要脚本路径（用 - 表示 stdin）" >&2; exit 2; }
    if [ "$sudo_run" -eq 1 ]; then
        echo "$self: -f 模式下 -s 无效（脚本里请自己写 sudo -n）" >&2
    fi
    if [ "$in_container" -eq 1 ]; then
        # 脚本直接从 stdin 喂给容器里的 bash -s；不跑宿主 PATH/agent 前导。
        if [ "$native" -eq 1 ]; then _interp='sh -s'; else _interp='bash --noprofile --norc -s'; fi
        if [ "$src" = "-" ]; then
            exec ssh -T "$host" "$(cprefix) $_interp"
        fi
        [ -r "$src" ] || { echo "$self: 读不到 $src" >&2; exit 2; }
        exec ssh -T "$host" "$(cprefix) $_interp" < "$src"
    fi
    if [ "$native" -eq 1 ]; then
        interp='sh -s'
    else
        interp='if command -v bash >/dev/null 2>&1; then exec bash --noprofile --norc -s; else exec sh -s; fi'
    fi
    if [ "$use_sess" -eq 1 ]; then
        if [ "$src" = "-" ]; then body=$(cat); else
            [ -r "$src" ] || { echo "$self: 读不到 $src" >&2; exit 2; }
            body=$(cat "$src")
        fi
        if [ "$sudo_run" -eq 1 ]; then
            exec "$HOME/.local/bin/sess" run "$host" "$body"
        fi
        pre=$body
        [ "$native" -eq 1 ] || pre="$path_prelude
$body"
        if agent_wanted "$body"; then pre="$agent_prelude
$pre"; fi
        exec "$HOME/.local/bin/sess" run "$host" "$pre"
    fi
    # 非 sess：前导脚本拼在远端命令里（stdin 留给脚本本体，保持流式）
    pre=""
    [ "$native" -eq 1 ] || pre=$path_prelude
    if [ "$src" = "-" ]; then
        # stdin 不能预读（要流式喂给 bash -s）→ 只有 RSH_AGENT=always 才探测
        [ "$agent_mode" = always ] && [ "$no_fix" != 1 ] && pre="$agent_prelude
$pre"
    elif [ -r "$src" ] && agent_wanted "$(cat "$src")"; then
        pre="$agent_prelude
$pre"
    fi
    [ -r "$src" ] || { [ "$src" = "-" ] || { echo "$self: 读不到 $src" >&2; exit 2; }; }
    if [ -n "$pre" ]; then
        b64=$(printf '%s' "$pre" | base64 | tr -d '\n')
        pre="eval \"\$(printf %s $b64 | base64 -d 2>/dev/null || printf %s $b64 | base64 -D)\"; "
    fi
    if [ "$src" = "-" ]; then
        exec ssh -T "$host" "$pre$interp"
    fi
    exec ssh -T "$host" "$pre$interp" < "$src"
fi

if [ $# -eq 0 ]; then
    if [ "$use_sess" -eq 1 ]; then
        echo "$self: --sess 是非交互会话，交互请直接 $self $host" >&2
        exit 2
    fi
    if [ "$in_container" -eq 1 ]; then
        # 交互用 run -- bash -l（能读 /etc/profile）；enter 在 ssh -t 下会挂住
        if [ "$native" -eq 1 ]; then exec ssh -t "$host" "$(cprefix) sh -l"; fi
        exec ssh -t "$host" "$(cprefix) bash -l"
    fi
    if [ "$native" -eq 1 ]; then
        exec ssh -t "$host"
    fi
    # 交互：登录 bash（读 /etc/profile、~/.profile 等），避免在 zsh 里手敲 bash 语法
    exec ssh -t "$host" 'if command -v bash >/dev/null 2>&1; then exec bash -l; else exec sh -l; fi'
fi

if [ "$sudo_run" -eq 1 ]; then
    sudo_check "$*"
fi

if [ "$in_container" -eq 1 ]; then
    # 跳过宿主 PATH/agent 前导：容器里没有那套 socket，探测只会误报。
    # 命令照旧本地 base64，由容器里的 bash 解析。
    if [ "$sudo_run" -eq 1 ]; then _body="sudo -n $*"; else _body=$*; fi
    if [ "$native" -eq 1 ]; then _shell='sh -c'; else _shell='bash --noprofile --norc -c'; fi
    exec ssh -T "$host" "$(cprefix) $_shell $(shq "$(b64_eval "$_body")")"
fi

if [ "$use_sess" -eq 1 ]; then
    # 常驻会话内部已是 bash，且 cd/变量跨命令保留；不再套 wrap（避免二次 base64）
    if [ "$sudo_run" -eq 1 ]; then
        exec "$HOME/.local/bin/sess" run "$host" "sudo -n $*"
    fi
    body=$*
    [ "$native" -eq 1 ] || body="$path_prelude
$body"
    if agent_wanted "$*"; then body="$agent_prelude
$body"; fi
    exec "$HOME/.local/bin/sess" run "$host" "$body"
fi

if [ "$sudo_run" -eq 1 ]; then
    # sudoers 按「命令路径」授权，所以 sudo -n 必须贴着用户命令，不能包 bash。
    # 复合命令已在 sudo_check 里拒绝（改用 -f）。
    exec ssh -T "$host" "$(wrap "sudo -n $*")"
fi

body=$*
if [ "$native" -eq 1 ]; then
    agent_wanted "$*" && body="$agent_prelude
$body"
    exec ssh -T "$host" "$(wrap "$body")"
fi
body="$path_prelude
$body"
if agent_wanted "$*"; then body="$agent_prelude
$body"; fi
exec ssh -T "$host" "$(wrap "$body")"
