#!/bin/sh
# wsh —— Windows 目标专用 ssh 外壳（远端默认 shell 可以是 pwsh / Windows PowerShell / cmd）
#
# 用法：
#   wsh <host>                     # 交互登录
#   wsh <host> '<代码>'             # 用「远端默认 shell」执行（多行也行，本地绝不做引号解析）
#   wsh -f <host> <本地脚本>        # 执行本地脚本文件
#   wsh -f <host> -                # 从 stdin 读脚本
#   wsh --shell cmd <host> '<cmd>'  # 强制用 cmd.exe 执行（pwsh/ps5 同理）
#   wsh --shell ps5 <host> '<代码>'  # 强制用 Windows PowerShell 5.1 执行
#   wsh kind <host>                 # 查看缓存的默认解释器（--reset 重探）
#   wsh --direct <host> '<代码>'     # 强制一次性 ssh（默认走 sess；keeper 异常时用）
#   wsh --sess <host> '<代码>'       # 兼容写法，等同默认
#
# 解释器：auto（默认）= 远端默认 shell；pwsh = PowerShell 7+；ps5 = Windows PowerShell 5.1；cmd = cmd.exe。
#   首次用到某台主机时探测一次并存到 ~/.cache/wsh/<host>.shell（pwsh|ps5|cmd），之后零开销；
#   换了 DefaultShell 用 `wsh kind --reset <host>` 重探。
#   跨解释器执行走 `pwsh.exe|powershell.exe -NoProfile -EncodedCommand <utf16le-base64>`，引号/换行/中文全免转义。
#   默认 shell 是 PowerShell 时 cmd 命令被包成 `& cmd.exe /d /c '...'`（单引号自动加倍）；默认是 cmd 时原样发送。
#   `--shell` 切换会在子进程里跑，cd/env 不跨命令保留（sess 的会话状态只在同解释器时有效）。
#
# 默认 = sess 常驻会话（实测 49～51 ms/条，直连 0.4 s～30 s 握手）。
# 唯一风险：keeper 变陈旧时每条命令都会退化（曾实测 147 s）。健康检查就一条：
#   sess run <host> 1  连跑两次；第二次应在 100 ms 内。慢就先 `sess stop <host>` 重建。
# 需要干净会话（脚本会改会话级状态）时加 --direct。
#
# 为什么不再用 `ssh win 'powershell -Command "..."'`：
#   1) 脚本本地转 base64，只由远端默认 shell 解码执行 —— 引号、$、反引号、换行、中文全免转义
#   2) 不嵌套子进程：Windows OpenSSH 下嵌套 pwsh/cmd 的退出码一律被吞成 1，只有本进程 exit 才透传
#   3) 输出编码强制 UTF-8（中文不乱码），吞掉 CLIXML / progress 噪声
#   4) 尾部显式 `exit`，所以 $LASTEXITCODE / 非终止错误都能变成真实退出码
#
# 注意：脚本上限约 20KB（Windows 命令行长度限制）。更大请先 scp 上去再执行。
# 本工具不写任何 .ps1 文件，脚本全部内联（远端 %TEMP% 里不会有残留）。
#
# 本地 ssh-agent：先内联 `ssh-add -l` 判定（~6ms），健康就不再调 ssh-unlock（省 ~25ms）；
# socket 陈旧 / agent 已死（rc=2）时就地 rm+重启+解锁，失败只在 stderr 打一行诊断。
# 控制：WSH_AGENT=auto|off（默认 auto），WSH_NO_AGENT_FIX=1 彻底关闭。

set -u

PROLOGUE='$ProgressPreference="SilentlyContinue"
$ErrorActionPreference="Continue"
if ($PSVersionTable.PSVersion.Major -lt 7) {
    # Windows PowerShell 5.1 默认按 ANSI/CLIXML 输出，必须显式转 UTF-8
    try { [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false } catch {}
    try { $OutputEncoding = New-Object System.Text.UTF8Encoding $false } catch {}
} else {
    # pwsh 7 管道输出本来就是 UTF-8 no-BOM；再赋一次 Console.OutputEncoding 会白白多花约 280ms
    try { $PSStyle.OutputRendering = "PlainText" } catch {}
}'

EPILOGUE='$__ok = $?
$__code = $LASTEXITCODE
if (-not $__ok) {
    if ($__code -is [int] -and $__code -ne 0) { exit $__code }
    exit 1
}
exit 0'

# ---- 远端命令构造 ---------------------------------------------------------

mkcmd() {
    # $1 = PowerShell 脚本文本；输出一条不含双引号的远端命令（默认 shell 是 PowerShell 时用）
    b64=$(printf '%s' "$1" | base64 -w0)
    printf '%s' "& ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$b64'))))"
}

mkcmd_ps() {
    # $1 = exe 名（pwsh.exe / powershell.exe），$2 = PowerShell 脚本文本
    # 输出跨解释器命令；脚本按 UTF-16LE 编码，完全绕开 Windows 命令行引号规则
    if ! command -v iconv >/dev/null 2>&1; then
        echo "wsh: 跨解释器执行需要 iconv（Debian: apt install libc-bin）" >&2
        exit 2
    fi
    _b64=$(printf '%s' "$2" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
    printf '%s' "$1 -NoProfile -EncodedCommand $_b64"
}

cmd_flatten() {
    # cmd /c 只认第一条命令行：多行脚本必须折叠成 `a & b`
    # （真正的批处理控制流 goto/label 不支持，需要就用 `wsh --shell cmd host 'C:\path\x.cmd'`）
    printf '%s\n' "$1" | awk '{ sub(/\r$/, "") } NF == 0 { next } { if (n++) printf " & "; printf "%s", $0 }'
}

ps_wrap_cmd() {
    # $1 = cmd.exe 命令文本；输出在 PowerShell 里执行它的代码（单引号加倍）
    _esc=$(printf '%s' "$(cmd_flatten "$1")" | sed "s/'/''/g")
    printf "& cmd.exe /d /c '%s'" "$_esc"
}

# ---- 默认解释器探测 -------------------------------------------------------

detect_shell() {
    # 成功时输出 pwsh|ps5|cmd 并写缓存；失败 return 1
    _sf="$HOME/.cache/wsh/$host.shell"
    if [ -f "$_sf" ]; then
        _k=$(cat "$_sf" 2>/dev/null)
        case "$_k" in
            pwsh|ps5|cmd) printf '%s\n' "$_k"; return 0 ;;
        esac
    fi
    _ver=$(timeout 30 ssh -T -o ConnectTimeout=10 "$host" '$PSVersionTable.PSVersion.Major' 2>/dev/null) || _ver=""
    case "$_ver" in
        7*) _k=pwsh ;;
        5*|4*|3*|2*) _k=ps5 ;;
        *)
            # 不是 PowerShell：再确认是不是 cmd（ssh 到 POSIX 机也会落到这里，按透传处理）
            _out=$(timeout 30 ssh -T -o ConnectTimeout=10 "$host" 'echo WSH_CMD_OK' 2>/dev/null) || _out=""
            case "$_out" in
                *WSH_CMD_OK*) _k=cmd ;;
                *) return 1 ;;
            esac
            ;;
    esac
    mkdir -p "$HOME/.cache/wsh" 2>/dev/null
    printf '%s\n' "$_k" > "$_sf" 2>/dev/null
    rm -f "$HOME/.cache/wsh/$host" 2>/dev/null   # 旧版一次性探针文件
    printf '%s\n' "$_k"
}

# ---- 参数 ----------------------------------------------------------------

mode=arg
use_sess=1
shell_sel=auto
[ "${WSH_DIRECT:-0}" = "1" ] && use_sess=0
HELP="awk 'NR>1 && /^#/ {sub(/^# ?/,\"\"); print; next} NR>1 {exit}' \"\$0\""

while [ $# -gt 0 ]; do
    case "$1" in
        -f) mode=file; shift ;;
        -S|--sess) use_sess=1; shift ;;
        --direct|--no-sess) use_sess=0; shift ;;
        --shell)
            [ $# -ge 2 ] || { echo "wsh: --shell 需要参数（auto|pwsh|ps5|cmd）" >&2; exit 2; }
            shell_sel=$2; shift 2 ;;
        --shell=*) shell_sel=${1#--shell=}; shift ;;
        --pwsh|--ps7) shell_sel=pwsh; shift ;;
        --ps5|--powershell) shell_sel=ps5; shift ;;
        --cmd) shell_sel=cmd; shift ;;
        -h|--help) eval "$HELP"; exit 0 ;;
        --) shift; break ;;
        -*) echo "wsh: 未知选项 $1" >&2; exit 2 ;;
        *) break ;;
    esac
done

case "$shell_sel" in
    auto|pwsh|ps5|cmd) ;;
    ps7|pwsh7|7) shell_sel=pwsh ;;
    powershell|powershell5|ps51|5) shell_sel=ps5 ;;
    cmd.exe) shell_sel=cmd ;;
    *) echo "wsh: --shell 只接受 auto|pwsh|ps5|cmd（收到 $shell_sel）" >&2; exit 2 ;;
esac

# `wsh kind [--reset] <host>`
if [ "${1:-}" = "kind" ]; then
    shift
    _reset=0
    [ "${1:-}" = "--reset" ] && { _reset=1; shift; }
    [ $# -ge 1 ] || { echo "wsh: kind 需要主机名" >&2; exit 2; }
    host=$1
    _sf="$HOME/.cache/wsh/$host.shell"
    [ "$_reset" = 1 ] && { rm -f "$_sf" "$HOME/.cache/wsh/$host"; }
    if [ -f "$_sf" ]; then
        cat "$_sf"
        exit 0
    fi
    detect_shell || { echo "wsh: 无法判断 $host 的默认 shell" >&2; exit 3; }
    exit 0
fi

[ $# -ge 1 ] || { eval "$HELP"; exit 2; }
host=$1; shift

# 本地 ssh-agent：健康时不 fork ssh-unlock（省 ~25ms），坏了就地自愈（与 rsh 同一套故障）。
# 只碰「本机自己的常驻 agent」：SSH_AUTH_SOCK 指向转发 agent 时绝不删/重启。
_wsh_agent=${WSH_AGENT:-auto}
if [ "${WSH_NO_AGENT_FIX:-0}" != 1 ] && [ "$_wsh_agent" != off ] && command -v ssh-add >/dev/null 2>&1; then
    _wsh_sock="$HOME/.ssh/agent.sock"
    _wsh_rc=0
    if [ -e "$_wsh_sock" ] || [ -f "$HOME/.config/systemd/user/ssh-agent.service" ]; then
        if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -e "$_wsh_sock" ]; then
            SSH_AUTH_SOCK=$_wsh_sock; export SSH_AUTH_SOCK
        fi
        ssh-add -l >/dev/null 2>&1; _wsh_rc=$?
    fi
    if [ "$_wsh_rc" -eq 2 ] && { [ -z "${SSH_AUTH_SOCK:-}" ] || [ "$SSH_AUTH_SOCK" = "$_wsh_sock" ]; }; then
        rm -f "$_wsh_sock"
        if command -v systemctl >/dev/null 2>&1 && systemctl --user restart ssh-agent >/dev/null 2>&1; then :
        elif command -v ssh-agent >/dev/null 2>&1; then ssh-agent -a "$_wsh_sock" >/dev/null 2>&1 || true
        fi
        SSH_AUTH_SOCK=$_wsh_sock; export SSH_AUTH_SOCK
        ssh-add -l >/dev/null 2>&1; _wsh_rc=$?
        _wsh_w=0
        while [ "$_wsh_rc" -eq 2 ] && [ "$_wsh_w" -lt 10 ]; do
            sleep 0.1
            ssh-add -l >/dev/null 2>&1; _wsh_rc=$?
            _wsh_w=$((_wsh_w + 1))
        done
    fi
    if [ "$_wsh_rc" -ne 0 ] && [ -x "$HOME/.local/bin/ssh-unlock" ]; then
        "$HOME/.local/bin/ssh-unlock" >/dev/null 2>&1 || true
        ssh-add -l >/dev/null 2>&1; _wsh_rc=$?
    fi
    if [ "$_wsh_rc" -ne 0 ] && { [ -e "$_wsh_sock" ] || [ -f "$HOME/.config/systemd/user/ssh-agent.service" ]; }; then
        echo "wsh: 本地 ssh-agent 无可用身份（socket=${SSH_AUTH_SOCK:-未设置}），连接会 publickey 失败；修复: rm -f ~/.ssh/agent.sock && systemctl --user restart ssh-agent && ssh-unlock" >&2
    fi
    unset _wsh_sock _wsh_rc _wsh_w
fi
unset _wsh_agent

case "$mode" in
    file)
        src=${1:-}
        [ -n "$src" ] || { echo "wsh: -f 需要脚本路径（用 - 表示 stdin）" >&2; exit 2; }
        if [ "$src" = "-" ]; then
            body=$(cat)
        else
            [ -r "$src" ] || { echo "wsh: 读不到 $src" >&2; exit 2; }
            body=$(cat "$src")
        fi
        ;;
    arg)
        if [ $# -eq 0 ]; then
            exec ssh -t "$host"
        fi
        body=$*
        ;;
esac

# ---- 决定用哪个解释器执行 body -------------------------------------------

def_kind=$(detect_shell) || {
    echo "wsh: 无法判断 $host 的默认 shell（既不是 PowerShell 也不是 cmd）" >&2
    echo "     可显式指定：wsh --shell cmd|pwsh|ps5 $host '<命令>'" >&2
    echo "     若远端默认 shell 不是 pwsh，可在 Windows 上改回：" >&2
    echo "       New-ItemProperty -Path 'HKLM:\\SOFTWARE\\OpenSSH' -Name DefaultShell -Value 'C:\\Program Files\\PowerShell\\7\\pwsh.exe' -PropertyType String -Force; Restart-Service sshd" >&2
    exit 3
}

if [ "$shell_sel" = auto ]; then target=$def_kind; else target=$shell_sel; fi

run_raw=0          # 1 = 直接把 body 当远端命令发（默认 shell 就是 cmd）
ps_code=""         # target 是 PowerShell 家族时，要交给默认 shell 的 PS 代码

case "$target" in
    cmd)
        if [ "$def_kind" = cmd ]; then
            run_raw=1
        else
            ps_code=$(ps_wrap_cmd "$body")
        fi
        ;;
    pwsh)
        if [ "$def_kind" = pwsh ]; then
            ps_code=$body
        else
            ps_code=$(mkcmd_ps pwsh.exe "$(printf '%s\n%s' "$PROLOGUE" "$body")")
        fi
        ;;
    ps5)
        if [ "$def_kind" = ps5 ]; then
            ps_code=$body
        else
            ps_code=$(mkcmd_ps powershell.exe "$(printf '%s\n%s' "$PROLOGUE" "$body")")
        fi
        ;;
esac

# cmd 默认 shell 下 sess 的常驻 loop 是 PowerShell，用不了 → 回落一次性 ssh
if [ "$run_raw" = 1 ] && [ "$use_sess" -eq 1 ]; then
    echo "wsh: 远端默认 shell 是 cmd，sess 协议不支持，回落一次性 ssh" >&2
    use_sess=0
fi

# --sess：交给常驻会话执行（协议、base64、退出码都由 sess 负责）
if [ "$use_sess" -eq 1 ] && [ -n "$body" ]; then
    sess_bin=""
    for c in "$HOME/.local/bin/sess" /usr/local/bin/sess; do
        [ -x "$c" ] && { sess_bin=$c; break; }
    done
    if [ -z "$sess_bin" ]; then
        sess_bin=$(command -v sess 2>/dev/null || true)
    fi
    if [ -n "$sess_bin" ]; then
        exec "$sess_bin" run "$host" "$ps_code"
    fi
    echo "wsh: 未找到 sess，回落一次性 ssh" >&2
fi

if [ "$run_raw" = 1 ]; then
    exec ssh -T "$host" "$(cmd_flatten "$body")"
fi

exec ssh -T "$host" "$(mkcmd "$(printf '%s\n%s\n%s\n' "$PROLOGUE" "$ps_code" "$EPILOGUE")")"
